# Frontend-visible Convex URL. This must be reachable from your browser.
VITE_CONVEX_URL=http://127.0.0.1:3210

# Local self-hosted Convex ports.
CONVEX_PORT=3210
CONVEX_SITE_PORT=3211
DASHBOARD_PORT=6791
FRONTEND_PORT=5173

# Must be a hex string. Generate one with:
#   openssl rand -hex 32
INSTANCE_NAME=ai-town-local
INSTANCE_SECRET=

# Required for `docker compose --profile tools run --rm convex-deploy`.
# Generate it after backend starts:
#   docker compose exec backend ./generate_admin_key.sh
CONVEX_SELF_HOSTED_ADMIN_KEY=

# Self-hosted Convex backend function runtime LLM config.
# Use the provider prefix for LLM_CHAT_API_URL and the full endpoint for
# LLM_CHAT_COMPLETIONS_URL when your provider does not follow the default path.
# Example:
#   LLM_CHAT_API_URL=https://api.vectorengine.ai
#   LLM_CHAT_COMPLETIONS_URL=https://api.vectorengine.ai/v1/chat/completions
LLM_CHAT_API_URL=
LLM_CHAT_COMPLETIONS_URL=
LLM_CHAT_API_KEY=
LLM_MODEL=
LLM_EMBEDDING_API_URL=
LLM_EMBEDDINGS_URL=
LLM_EMBEDDING_API_KEY=
LLM_EMBEDDING_MODEL=
